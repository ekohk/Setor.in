# ────────────────────────────────────────────────────────────────────────
# Setor.in Backend — Environment Variables
# Copy ini ke .env dan isi sesuai environment
# ────────────────────────────────────────────────────────────────────────

# ─── App ─────────
APP_NAME=setorin-api
APP_ENV=development               # development | staging | production
APP_PORT=8000
APP_LOG_LEVEL=debug                # debug | info | warn | error

# ─── Database (Postgres app) ─────────
DB_HOST=localhost
DB_PORT=5435
DB_USER=setorin
DB_PASSWORD=setorin_dev_pw
DB_NAME=setorin
DB_SSLMODE=disable                 # disable | require | verify-full
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m

# Computed (dipakai goose):
DB_DSN=postgres://setorin:setorin_dev_pw@localhost:5435/setorin?sslmode=disable

# ─── Keycloak ─────────
KEYCLOAK_BASE_URL=http://localhost:8090
KEYCLOAK_REALM=setorin
KEYCLOAK_ISSUER=http://localhost:8090/realms/setorin
KEYCLOAK_JWKS_URL=http://localhost:8090/realms/setorin/protocol/openid-connect/certs

KEYCLOAK_BACKEND_CLIENT_ID=setorin-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME_AFTER_KEYCLOAK_SETUP

KEYCLOAK_WEB_CLIENT_ID=setorin-web

# JWT validation
JWT_AUDIENCE=setorin-web,account
JWT_CLOCK_SKEW_SECONDS=60
JWKS_CACHE_TTL=1h

# ─── CORS ─────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Email (dev = MailHog, prod = Resend) ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@setor.in
SMTP_FROM_NAME=Setor.in

# ─── Rate limit ─────────
RATE_LIMIT_AUTH_SYNC_PER_MIN=10
