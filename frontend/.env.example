# ────────────────────────────────────────────────────────────────────────
# Setor.in Frontend — Environment Variables
# Copy ke .env.local dan isi. NEVER commit .env.local.
# ────────────────────────────────────────────────────────────────────────

# ─── App ─────────
# Where the frontend is hosted (used by Auth.js for callbacks)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random 32+ char string for encrypting Auth.js session cookies.
# Generate: openssl rand -base64 32
# Or: npx auth secret
AUTH_SECRET=change_me_to_a_long_random_string_at_least_32_chars_long_xxxx

# ─── Backend ─────────
# Where the Setor.in Go backend runs (server-side fetch only)
BACKEND_URL=http://localhost:8000

# ─── Keycloak (server-side use) ─────────
KEYCLOAK_BASE_URL=http://localhost:8090
KEYCLOAK_REALM=setorin
KEYCLOAK_CLIENT_ID=setorin-web

# ─── Keycloak (exposed to browser for register/forgot-password redirects) ─────────
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8090
NEXT_PUBLIC_KEYCLOAK_REALM=setorin
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=setorin-web
